function step_idx = funcGetCoalescenceStep(data)

% obatin defromation gradient history
u11 = data(:,23);
u22 = data(:,24);
u33 = data(:,25);

% velocity list
num_step = length(u11);
v11 = zeros([num_step 1]);
v22 = zeros([num_step 1]);
v33 = zeros([num_step 1]);
for i=2:num_step
    v11(i) = u11(i) - u11(i-1);
    v22(i) = u22(i) - u22(i-1);
    v33(i) = u33(i) - u33(i-1);
    if max() < 0.05 * v11(i)

    end
end

step_idx = 1;

end

